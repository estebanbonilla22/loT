        {
          "name": "Register (usuario único)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('username', 'pmuser_' + Date.now());",
                  "pm.collectionVariables.set('password', 'TestPass123!');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Tiene token JWT', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j).to.have.property('token');",
                  "    pm.expect(j.token).to.be.a('string');",
                  "    pm.expect(j.token.length).to.be.above(20);",
                  "    pm.collectionVariables.set('token', j.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/register"
